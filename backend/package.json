{
  "name": "erp-platform",
  "version": "0.0.1",
  "description": "ERP Platform - Unified NestJS application with DDD/hexagonal architecture",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch -e \"node -r tsconfig-paths/register\"",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/database/seed.ts",
    "seed:abac": "ts-node -r tsconfig-paths/register src/database/seed-abac.ts",
    "migrate:visible-menus": "ts-node -r tsconfig-paths/register src/database/migrate-visible-menus.ts",
    "migrate:organization-names": "ts-node -r tsconfig-paths/register src/database/migrate-organization-names.ts",
    "migrate:internal-user-refs": "ts-node -r tsconfig-paths/register src/database/migrate-internal-user-department-ids.ts",
    "migrate:internal-user-indexes": "ts-node -r tsconfig-paths/register src/database/migrate-internal-user-indexes.ts",
    "migrate:booking-versions": "ts-node -r tsconfig-paths/register scripts/migrate-booking-versions.ts",
    "migrate": "ts-node -r tsconfig-paths/register src/database/migrate.ts",
    "migration": "npm run migrate",
    "seed:device-types": "ts-node -r tsconfig-paths/register src/database/device-type.seed.ts",
    "seed:activity-logs": "ts-node -r tsconfig-paths/register src/database/seed-activity-logs.ts",
    "seed:device-statuses": "ts-node -r tsconfig-paths/register src/database/device-status.seed.ts",
    "seed:positions": "ts-node -r tsconfig-paths/register src/database/position.seed.ts",
    "seed:meeting-rooms": "ts-node -r tsconfig-paths/register src/database/meeting-room.seed.ts",
    "reconcile:device-summaries": "ts-node -r tsconfig-paths/register src/database/reconcile-device-summaries.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "async-mutex": "^0.5.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "csv-parser": "^3.2.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "json2csv": "^5.0.7",
    "lodash": "^4.17.21",
    "mongoose": "^8.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "path-to-regexp": "^8.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/lodash": "^4.17.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.1.0",
    "prettier": "^3.4.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    }
  }
}
